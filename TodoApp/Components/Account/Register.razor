@page "/Account/Register"
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
<PageTitle>Регистрация</PageTitle>
<section class="auth-panel"><p class="eyebrow">Начните планировать</p><h1>Создать аккаунт</h1><p class="text-muted">Сохраняйте задачи и следите за их выполнением.</p>
@if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
<EditForm Model="Input" method="post" OnValidSubmit="RegisterAsync" FormName="register" Enhance="false">
    <DataAnnotationsValidator /><ValidationSummary class="text-danger" role="alert" />
    <div class="mb-3"><label for="email" class="form-label">Электронная почта</label><InputText id="email" type="email" @bind-Value="Input.Email" class="form-control" autocomplete="username" /></div>
    <div class="mb-3"><label for="password" class="form-label">Пароль</label><InputText id="password" type="password" @bind-Value="Input.Password" class="form-control" autocomplete="new-password" /><div class="form-text">Не менее 8 символов: строчная и заглавная латинские буквы, цифра.</div></div>
    <div class="mb-4"><label for="confirm" class="form-label">Повторите пароль</label><InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" /></div>
    <button type="submit" class="btn btn-primary w-100">Зарегистрироваться</button>
</EditForm><p class="mt-4 mb-0">Уже есть аккаунт? <a href="/Account/Login">Войти</a></p></section>
@code {
    [SupplyParameterFromForm] private RegisterInput Input { get; set; } = new();
    private string? error;
    private async Task RegisterAsync()
    {
        var email = Input.Email.Trim();
        var user = new ApplicationUser { UserName = email, Email = email };
        var result = await UserManager.CreateAsync(user, Input.Password);
        if (!result.Succeeded)
        {
            error = result.Errors.Any(item => item.Code.StartsWith("Duplicate", StringComparison.Ordinal))
                ? "Аккаунт с такой почтой уже существует."
                : "Не удалось создать аккаунт. Проверьте почту и требования к паролю.";
            return;
        }
        await SignInManager.SignInAsync(user, isPersistent: false);
        Navigation.NavigateTo("/", forceLoad: true);
    }
    public sealed class RegisterInput
    {
        [Required(ErrorMessage = "Введите почту."), EmailAddress(ErrorMessage = "Проверьте адрес почты.")]
        public string Email { get; set; } = "";
        [Required(ErrorMessage = "Введите пароль."), StringLength(100, MinimumLength = 8, ErrorMessage = "Пароль должен содержать от 8 до 100 символов.")]
        public string Password { get; set; } = "";
        [Compare(nameof(Password), ErrorMessage = "Пароли не совпадают.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
